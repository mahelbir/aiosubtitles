{
  "name": "api",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "storage",
    "public-client"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --watch ../../packages --watch ../../.env --watch ../../.env.development --ext js,mjs,cjs,json src/server.js",
    "db:migrate": "node src/db/cli/migrate.js up",
    "db:rollback": "node src/db/cli/migrate.js down",
    "db:seed": "node src/db/cli/seed.js up",
    "db:seed:mock": "node src/db/cli/seed-mock.dev.js",
    "db": "pnpm db:migrate && pnpm db:seed",
    "e2e:server": "NODE_ENV=test node tests/e2e/server.js"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "@fastify/type-provider-zod": "^1.0.3",
    "@mahelbir/settings": "^6.0.0",
    "@repo/shared": "workspace:*",
    "@repo/tooling": "workspace:*",
    "background-job": "^2.0.0",
    "close-with-grace": "^2.5.0",
    "dayjs": "^1.11.23",
    "enum-plus": "^3.4.0",
    "es-toolkit": "^1.53.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "melperjs": "^17.4.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "proxy-addr": "^2.0.8",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "pino-pretty": "^13.2.0"
  }
}
